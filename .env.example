# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Resend (alertas por email)
RESEND_API_KEY=re_xxxxxxxxxxxx
ALERT_EMAIL_FROM=alertas@ilnet.com.br

# CNPJ da ILNET (usado pra identificar entrada/saída em NFs)
ILNET_CNPJ=00000000000000

# Claude API (OCR de PDFs de NF)
ANTHROPIC_API_KEY=sk-ant-xxx

# Alertas no celular (web push) — gere com: npx web-push generate-vapid-keys
#
# A pública mantém o prefixo NEXT_PUBLIC_ por herança, mas NÃO é embutida no
# código: quem a lê é o servidor, em tempo de execução (operador/actions.ts).
# O build roda dentro do EasyPanel antes de as variáveis existirem, então
# embutir dava chave vazia com a variável salva ali do lado.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cora (Integração Direta) — emissão de boleto e conciliação automática de
# pagamento em Contas. Gerar em: Cora > Conta > Integrações via APIs >
# Integração Direta. CORA_CERTIFICATE e CORA_PRIVATE_KEY são o conteúdo dos
# arquivos .pem/.key (não o caminho) — cole com quebras de linha reais.
# Depois do deploy, registrar o webhook uma vez com
# scripts/cora-registrar-webhook.mjs (ver o comentário no topo do arquivo).
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERTIFICATE=
CORA_PRIVATE_KEY=
